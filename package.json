{
  "name": "seancheong.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "eslint src --max-warnings 0 --no-config-lookup --config eslint.dependencies.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test --grep-invert \"accessibility\"",
    "test:axe": "QUALITY_SUITE=axe playwright test accessibility --project chromium",
    "test:performance": "node scripts/quality/lighthouse.mjs",
    "test:release": "node scripts/quality/lighthouse.mjs --enforce",
    "test:probes": "node scripts/quality/verify-probes.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.699.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@vercel/analytics": "^1.3.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.10",
    "isomorphic-dompurify": "^2.16.0",
    "jsdom": "^26.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.452.0",
    "motion": "^12.19.0",
    "next": "15.4.10",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.1",
    "sharp": "^0.33.5",
    "sonner": "^1.5.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "chrome-launcher": "1.2.2",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.4.10",
    "eslint-plugin-prettier": "^5.5.0",
    "lighthouse": "13.5.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^4.1.10",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "22.x",
